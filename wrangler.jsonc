{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wms-wcs-aoi-fetcher",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "wms-wcs-aoi-feedback",
      "database_id": "8fd34457-faac-4248-97c9-ef2f2ab5b299",
      "migrations_dir": "migrations"
    }
  ],
  // Per-IP limits (see rateLimited() in src/worker.mjs). The proxy allowance
  // is generous on purpose: one 64-tile download is 64 requests in a burst.
  // namespace_id is an arbitrary number that only has to be unique within
  // this Cloudflare account.
  "ratelimits": [
    { "name": "PROXY_LIMITER", "namespace_id": "7101", "simple": { "limit": 300, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "7102", "simple": { "limit": 30, "period": 60 } },
    { "name": "FEEDBACK_LIMITER", "namespace_id": "7103", "simple": { "limit": 5, "period": 60 } }
  ],
  // NOTIFY_EMAIL is the destination for feedback notifications (see
  // notifyFeedback() in src/worker.mjs) -- not secret, just a plain address.
  // The other half, RESEND_API_KEY, is a secret and is NOT set here; set it
  // once with `npx wrangler secret put RESEND_API_KEY` (get the key from
  // https://resend.com/api-keys). Feedback still saves fine without either
  // -- the email is a convenience, not a requirement.
  "vars": {
    "NOTIFY_EMAIL": "adel.bchini@gmail.com"
  },
  // Cloudflare tracks Durable Object classes at the account level, tied to
  // this script, independent of whether the class is still declared above.
  // Simply removing the old "containers"/"durable_objects" blocks (and the
  // GdalProcessor class from src/worker.mjs) left the account still
  // expecting that class to exist -- every deploy failed with "does not
  // export class 'GdalProcessor' which is depended on by existing Durable
  // Objects" until this delete-class migration retires it properly.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GdalProcessor"] },
    { "tag": "v2", "deleted_classes": ["GdalProcessor"] }
  ]
}
